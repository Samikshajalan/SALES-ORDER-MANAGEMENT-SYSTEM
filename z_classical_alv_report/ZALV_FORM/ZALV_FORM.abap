FORM GET .
SELECT A~ORDER_ID A~CUST_ID B~CITY A~MAT_ID C~MAT_NAME A~QUANTITY C~PRICE
FROM ZSALES_ORDER AS A
INNER JOIN ZCUSTOMER1 AS B
ON A~CUST_ID = B~CUST_ID
INNER JOIN ZPRODUCT1 AS C
ON A~MAT_ID = C~MAT_ID
INTO TABLE IT1
WHERE A~ORDER_ID IN OID AND A~CUST_ID IN CID.

LOOP AT IT1 INTO WA1.
WA1-TOTAL_AMOUNT =  WA1-PRICE * WA1-QUANTITY.
MODIFY IT1 FROM WA1.
ENDLOOP.
ENDFORM.


