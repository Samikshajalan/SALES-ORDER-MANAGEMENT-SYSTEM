FORM EVENT .
CLEAR WAE.
WAE-NAME = 'USER COMMAND'.
WAE-FORM = 'CLASSICAL'.
APPEND WAE TO ITE.

CLEAR WAE.
WAE-NAME = 'TOP_OF_PAGE'.
WAE-FORM = 'HEADING'.
APPEND WAE TO ITE.
ENDFORM.

FORM HEADING.

DATA: STR TYPE STRING.
DATA: WAL TYPE SLIS_LISTHEADER,
      ITL TYPE SLIS_T_LISTHEADER.

CLEAR WAL.
WAL-TYP = 'H'.
WAL-INFO = 'SALES ORDER REPORT'.
APPEND WAL TO ITL.
CLEAR WAL.
WAL-TYP = 'H'.
WAL-INFO = 'USERNAME'.
WAL-INFO = SY-UNAME.
APPEND WAL TO ITL.
CLEAR WAL.
WAL-TYP = 'S'.
WAL-KEY = 'DATE'.
CONCATENATE SY-DATUM+6(2) SY-DATUM+4(2) SY-DATUM+0(4) INTO STR SEPARATED BY '.'.
WAL-INFO = STR.
APPEND WAL TO ITL.

CALL FUNCTION 'REUSE_ALV_COMMENTARY_WRITE'
  EXPORTING
    IT_LIST_COMMENTARY       = ITL.
          .
ENDFORM.
